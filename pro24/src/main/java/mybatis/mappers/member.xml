<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.member">
	<resultMap id="memResult" type="memberVO">
		<result property="id" column="id" />
		<result property="pwd" column="pwd" />
		<result property="name" column="name" />
		<result property="email" column="email" />
		<result property="joinDate" column="joinDate" />
	</resultMap>

	<!-- 23.3 / 23.4.3 : 전체 회원 조회 -->
	<select id="selectAllMemberList" resultMap="memResult">
		<![CDATA[
			select * from t_member order by joinDate desc
		]]>
	</select>

	<!-- 23.4.1 : hong 회원의 이름 / 비밀번호 조회 -->
	<select id="selectName" resultType="String">
		<![CDATA[
			select name from t_member where id = 'hong'
		]]>
	</select>

	<select id="selectPwd" resultType="int">
		<![CDATA[
			select pwd from t_member where id = 'hong'
		]]>
	</select>

	<!-- 23.4.3 : 조건 값(id / pwd)으로 회원 조회 -->
	<select id="selectMemberById" resultType="memberVO" parameterType="String">
		<![CDATA[
			select * from t_member where id = #{id}
		]]>
	</select>

	<select id="selectMemberByPwd" resultMap="memResult" parameterType="int">
		<![CDATA[
			select * from t_member where pwd = #{pwd}
		]]>
	</select>

	<!-- 23.4.4 : 회원 추가 (MemberVO) -->
	<insert id="insertMember" parameterType="memberVO">
		<![CDATA[
			insert into t_member(id, pwd, name, email)
			values(#{id}, #{pwd}, #{name}, #{email})
		]]>
	</insert>

	<!-- 23.4.5 : 회원 추가 (HashMap) -->
	<insert id="insertMember2" parameterType="java.util.HashMap">
		<![CDATA[
			insert into t_member(id, pwd, name, email)
			values(#{id}, #{pwd}, #{name}, #{email})
		]]>
	</insert>

	<!-- 23.4.6 : 회원 정보 수정 -->
	<update id="updateMember" parameterType="memberVO">
		<![CDATA[
			update t_member
			set pwd=#{pwd}, name=#{name}, email=#{email}
			where id=#{id}
		]]>
	</update>

	<!-- 23.4.7 : 회원 정보 삭제 -->
	<delete id="deleteMember" parameterType="String">
		<![CDATA[
			delete from t_member where id=#{id}
		]]>
	</delete>
</mapper>
